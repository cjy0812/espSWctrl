root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# 文档里的表格/缩进对空格敏感，但行尾空格仍要清
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml,json,toml}]
indent_size = 2

# Windows 批处理必须 CRLF，且必须纯 ASCII（cmd 按 OEM 码页解析）
[*.{cmd,bat}]
end_of_line = crlf
charset = latin1

[*.rs]
max_line_length = 100