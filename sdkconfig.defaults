# =============================================================================
# espSWctrl - build defaults
#
# sdkconfig.defaults is applied whenever sdkconfig is (re)generated, so these
# settings survive fullclean / re-clone / moving to another machine.
# Keep this file pure ASCII.
# =============================================================================

# --- Flash size -------------------------------------------------------------
# Confirmed 4MB on 2026-10-17 from the boot log itself, which is ground truth:
#   W spi_flash: Detected size(4096k) larger than the size in the binary image
#                 header(2048k). Using the size in the binary image header.
# The chip reports 4096k; 2MB was a conservative guess while the part was
# unconfirmed. Now that it is measured, raise it -- the failure mode of
# under-configuring is that the app partition cannot grow past ~1.4MB, and
# Phase 3 (WiFi + mbedTLS + MQTT) is projected at ~1.13MB, uncomfortably close.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- Partition table --------------------------------------------------------
# Stock partitions_singleapp.csv gives the app only 1MB (0x100000), which does
# not fit MQTT + mbedTLS + cJSON. The _large variant gives 1500K (0x180000).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_PARTITION_TABLE_FILENAME="partitions_singleapp_large.csv"

# --- Optimization -----------------------------------------------------------
# ESP-IDF defaults to -Og (debug friendly), which built this firmware to 1.05MB.
# -Os lands around 700KB with identical behaviour, just harder to single-step.
# For debugging, swap this for CONFIG_COMPILER_OPTIMIZATION_DEBUG=y.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Assertions stay ON. This is safety relevant: a stuck GPIO must be catchable by
# assertion / watchdog, so a few extra KB is the right trade.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# --- Console ----------------------------------------------------------------
# COM11 on this board is the chip's native USB Serial/JTAG (VID 303A:PID 1001),
# not a USB-UART bridge. The USB-Serial-JTAG backend only accepts input when it
# is the PRIMARY console; as a secondary one it is output-only and the REPL
# (used by the runtime config commands) would never read a line.
# So: USB-Serial/JTAG primary, UART0 off, no secondary.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y

# --- IPv6 SLAAC (DDNS AAAA) -------------------------------------------------
# Double gate for IPv6:
#   1. CONFIG_LWIP_IPV6=y            - the whole lwIP IPv6 stack is compiled in.
#   2. CONFIG_LWIP_IPV6_AUTOCONFIG=y - SLAAC: accept router advertisements and
#      auto-generate a global address from the RA prefix.
# Espressif ships (2) OFF by default on purpose:
#   "users might end up with devices, globally accessible on the internet,
#    without even knowing about it"
# DDNS needs a real global AAAA to publish, so we turn it on explicitly here.
# It stays OFF unless BOTH this and the runtime enable_ipv6 flag are set
# (see DDNS_IPV6_COMPILE_ENABLE / DdnsClient::enable_ipv6).
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# --- TLS: cross-signed root verification -------------------------------------
# api005.dnshe.com serves a chain whose root "GTS Root R4" is cross-signed by
# the legacy "GlobalSign Root CA" (R1), which is NOT in the ESP certificate
# bundle (we ship R3/R5/R6/R46/E46 only; cacrt_deprecated.pem is empty).
# Without this, TLS fails with:
#   esp-x509-crt-bundle: No matching trusted root certificate found
#   mbedtls_ssl_handshake returned -0x3000
# With it, the CA callback resolves WE1 directly to the self-signed
# GTS Root R4 already in the bundle (same public key), ending the chain there
# instead of walking up through the cross-signed cert. Costs ~700 B heap.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# --- TLS: certificate expiry check -------------------------------------------
# MBEDTLS_HAVE_TIME_DATE defaults to OFF in ESP-IDF, which compiles the whole
# notBefore/notAfter check out of the certificate verification path. That means
# an expired or not-yet-valid certificate would be accepted silently.
# Turn it ON so the MQTT broker certificate is actually time-validated.
#
# Cost: mbedTLS uses libc time(). If SNTP has not synced yet the clock reads
# 1970, every certificate looks "not yet valid" and the TLS handshake fails.
# The device already needs correct time for the cmd `ts` window, so this is not
# a new failure mode -- but it makes "SNTP synced" a hard precondition before
# the MQTT client may connect (enforced in mqtt_tick).
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
